# ====================================================================
# BRIEFLY — ENVIRONMENT VARIABLES CONFIGURATION
# ====================================================================
# Note: The platform operates in fully functional standalone demo mode
# out-of-the-box without requiring third-party API keys.
# When deploying to production on Vercel or connecting Supabase, fill below.

# --- SUPABASE / POSTGRESQL (Optional for production cloud DB) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key

# --- NEWS & RSS INGESTION PROVIDERS ---
NEWS_API_KEY=your_news_api_key_here

# --- OFFICIAL DISASTER & EMERGENCY WARNING SYSTEM ---
NDMA_SACHET_ENDPOINT=https://sachet.ndma.gov.in/api/v1/cap

# --- APPLICATION AUTH & SECURITY SECRETS (Server-Only) ---
# NEVER prefix private secrets with NEXT_PUBLIC_
SESSION_SECRET=your_32_character_cryptographic_session_secret
ADMIN_API_KEY=your_secure_admin_management_key

# --- AI & LLM PROVIDER (Optional - fallback uses deterministic heuristic summarizer) ---
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
